# Copy this file to `.env` and fill in the keys for the answerers/judge you want to use.
# Every key is optional — you only need the ones referenced by your config
# (configs/default.yaml). Missing keys fail loudly with a clear message, not silently.

# --- Judge / LLM answerers -------------------------------------------------
# Anthropic (default judge, and the `llm_websearch` agent contestant).
ANTHROPIC_API_KEY=

# Any OpenAI-compatible endpoint. This one backend covers OpenAI, Groq,
# Google's OpenAI-compat endpoint, and local Ollama — pick one via base_url.
# Examples:
#   OpenAI:  https://api.openai.com/v1
#   Groq:    https://api.groq.com/openai/v1     (generous free tier)
#   Gemini:  https://generativelanguage.googleapis.com/v1beta/openai
#   Ollama:  http://localhost:11434/v1          (fully local, no key needed)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Search-engine answerers ----------------------------------------------
# Tavily — the default search answerer (has a free tier). https://tavily.com
TAVILY_API_KEY=

# Perplexity Sonar. https://docs.perplexity.ai
PERPLEXITY_API_KEY=

# Google results via SerpAPI. https://serpapi.com
SERPAPI_API_KEY=
