# Copy this file to `.env` and fill in the keys for the answerers/judge you want
# to use. Every key is optional — you only need the ones your config references
# (configs/default.yaml). Missing keys fail loudly with a clear message.

# --- Zero-cost path (recommended) -----------------------------------------
# The OpenAI-compatible backend points at OpenRouter's FREE models by default,
# so the judge and the `llm_direct` contestant cost nothing. Get a free key at
# https://openrouter.ai/keys , then set it here. Free model ids (the `:free`
# suffix) are listed at https://openrouter.ai/models?max_price=0 — e.g.
# deepseek/deepseek-chat-v3-0324:free or z-ai/glm-4.5-air:free.
#
# This one backend also works for OpenAI, Groq, Gemini, and local Ollama —
# just change OPENAI_BASE_URL (and the model in your config):
#   OpenAI:  https://api.openai.com/v1
#   Groq:    https://api.groq.com/openai/v1            (free tier)
#   Gemini:  https://generativelanguage.googleapis.com/v1beta/openai
#   Ollama:  http://localhost:11434/v1                 (fully local, key unused)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# --- Search-engine answerers ----------------------------------------------
# DuckDuckGo (`duckduckgo` answerer) needs NO key — it's the zero-signup search
# contestant. Nothing to set here for it.

# Tavily — free tier. https://app.tavily.com
TAVILY_API_KEY=

# Google, the FREE way (`google_cse` answerer): the Custom Search JSON API gives
# 100 queries/day at no cost. You need two free things:
#   1. An API key:  https://developers.google.com/custom-search/v1/introduction
#   2. A Programmable Search Engine (set it to search the whole web), whose
#      "Search engine ID" goes in GOOGLE_CSE_ID:  https://programmablesearchengine.google.com
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# --- Paid (or subscription-credit) options --------------------------------
# Anthropic (Claude) — the `llm_websearch` agent contestant. Paid API; new API
# accounts sometimes get a small trial credit. (A Claude.ai / Claude Code
# subscription is NOT usable as an API key.)
ANTHROPIC_API_KEY=

# Perplexity Sonar (`perplexity` answerer). Paid API — BUT Perplexity Pro
# subscribers get $5/month of API credits, enough for small runs.
PERPLEXITY_API_KEY=

# Google results via SerpAPI (`google_serpapi`). Free tier 100/mo, but google_cse
# above is the fully-free path. https://serpapi.com
SERPAPI_API_KEY=
