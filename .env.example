# Copy this file to `.env` and fill in the keys for the answerers/judge you want
# to use. Every key is optional — you only need the ones your config references
# (configs/default.yaml). Missing keys fail loudly with a clear message.

# --- Zero-cost path (recommended) -----------------------------------------
# The OpenAI-compatible backend points at OpenRouter's FREE models by default,
# so the judge and the `llm_direct` contestants cost nothing. Get a free key at
# https://openrouter.ai/keys , then set it here. Free model ids (the `:free`
# suffix) are listed at https://openrouter.ai/models?max_price=0 — the ones in
# configs/default.yaml are a starting point; free ids come and go.
#
# This one backend also works for OpenAI, Groq, Gemini, and local Ollama —
# just change OPENAI_BASE_URL (and the model in your config):
#   OpenAI:  https://api.openai.com/v1
#   Groq:    https://api.groq.com/openai/v1            (free tier)
#   Gemini:  https://generativelanguage.googleapis.com/v1beta/openai
#   Ollama:  http://localhost:11434/v1                 (fully local, key unused)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# --- Search-engine answerers ----------------------------------------------
# DuckDuckGo (`duckduckgo` answerer) needs NO key — it's the zero-signup search
# contestant. Nothing to set here for it.

# Tavily — free tier. https://app.tavily.com
TAVILY_API_KEY=

# Google results via SerpAPI (`google_serpapi` answerer) — free plan of 250
# searches/month. This is the Google option for new users. https://serpapi.com
SERPAPI_API_KEY=

# Google Custom Search JSON API (`google_cse` answerer) — EXISTING customers only:
# Google closed it to new customers and shuts it down on 2027-01-01. If you
# already have access, set your API key and Programmable Search Engine id.
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# --- Paid options ---------------------------------------------------------
# Anthropic (Claude) — the `llm_websearch` agent contestant. Paid API; new API
# accounts sometimes get a small trial credit. (A Claude.ai / Claude Code
# subscription is NOT usable as an API key.)
ANTHROPIC_API_KEY=

# Perplexity (`perplexity` answerer) — paid API, pay-as-you-go credits. Note:
# Perplexity has deprecated the Sonar chat-completions API this answerer calls in
# favor of its Agent API, so it may stop working.
PERPLEXITY_API_KEY=
