# Copy this file to `.env` and fill in the keys for the answerers/judge you want
# to use. Every key is optional — you only need the ones your config references
# (configs/default.yaml). Missing keys fail loudly with a clear message.

# --- Zero-cost path (recommended) -----------------------------------------
# The OpenAI-compatible backend points at OpenRouter's FREE models by default,
# so the judge and the `llm_direct` contestant cost nothing. Get a free key at
# https://openrouter.ai/keys , then set it here. Free model ids (the `:free`
# suffix) are listed at https://openrouter.ai/models?max_price=0 — e.g.
# deepseek/deepseek-chat-v3-0324:free or z-ai/glm-4.5-air:free.
#
# This one backend also works for OpenAI, Groq, Gemini, and local Ollama —
# just change OPENAI_BASE_URL (and the model in your config):
#   OpenAI:  https://api.openai.com/v1
#   Groq:    https://api.groq.com/openai/v1            (free tier)
#   Gemini:  https://generativelanguage.googleapis.com/v1beta/openai
#   Ollama:  http://localhost:11434/v1                 (fully local, key unused)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# --- Search-engine answerers ----------------------------------------------
# Tavily — free tier, the default search contestant. https://app.tavily.com
TAVILY_API_KEY=

# --- Paid / optional ------------------------------------------------------
# Anthropic (Claude) — the `llm_websearch` agent contestant. Paid API.
ANTHROPIC_API_KEY=

# Perplexity Sonar. Paid. https://docs.perplexity.ai
PERPLEXITY_API_KEY=

# Google results via SerpAPI. Free tier (100/mo). https://serpapi.com
SERPAPI_API_KEY=
